# ============================================================
# sahibindenhayvan.com — Ortam Değişkenleri
# Kopyala:  cp .env.example .env
# Vercel'de her birini Environment Variables olarak ekleyin.
# (VITE_ ile başlayanlar tarayıcıya gider — gizli anahtar KOYMAYIN)
# ============================================================

# ── Veritabanı (Supabase PostgreSQL) ─────────────────────────
# Supabase Dashboard → Connect → "Transaction pooler" (port 6543)
# Vercel/serverless için MUTLAKA pooler kullanın, doğrudan 5432 değil.
DATABASE_URL=postgresql://postgres.[PROJE_ID]:[SIFRE]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Migration (db:push) için doğrudan bağlantı — pooler prepared statement'ı desteklemez
DIRECT_URL=postgresql://postgres:[SIFRE]@db.[PROJE_ID].supabase.co:5432/postgres

# ── Supabase (Storage + API) ─────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://[PROJE_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # service_role (GİZLİ, sadece sunucu)
SUPABASE_ANON_KEY=eyJ...                # anon / public key
SUPABASE_STORAGE_BUCKET=uploads

# ── Oturum ───────────────────────────────────────────────────
# Rastgele güçlü string:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ── Uygulama ─────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Canlı alan adınız (cookie/CORS/e-posta linkleri için)
APP_URL=http://localhost:5000
# Admin paneli PIN'i — TANIMLI DEĞİLSE admin paneli tamamen kapalıdır.
# Tahmin edilebilir bir değer KULLANMAYIN (doğum tarihi, 123456, 252525 vb.).
ADMIN_PANEL_PIN=

# ── E-posta (Resend) — opsiyonel ─────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=

# ── Redis (Upstash) — opsiyonel, cache ───────────────────────
# https://console.upstash.com → New Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Firebase Admin (sunucu tarafı SMS/token doğrulama) ───────
# Firebase Console → Proje Ayarları → Hizmet Hesapları → Yeni özel anahtar
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── reCAPTCHA (sunucu) ───────────────────────────────────────
# https://www.google.com/recaptcha/admin  (Enterprise: Google Cloud Console)
# UYARI: üretimde bu değerler eksikse reCAPTCHA doğrulaması REDDEDER (fail closed).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SITE_KEY=

# ── OAuth (opsiyonel — Google / Facebook ile giriş) ──────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ============================================================
# İSTEMCİ (tarayıcı) değişkenleri — VITE_ öneki zorunlu
# Bunlar herkese açıktır, gizli anahtar koymayın.
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_RECAPTCHA_SITE_KEY=

# ============================================================
# DEPLOY OTOMASYONU (sadece scripts/ için — Vercel'e eklemeyin)
# ============================================================
# GoDaddy DNS otomasyonu: https://developer.godaddy.com/keys
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_DOMAIN=sahibindenhayvan.com
# Vercel'in verdiği A kaydı IP'si (Vercel Domains ekranında gösterilir)
VERCEL_DNS_A_RECORD=76.76.21.21
VERCEL_DNS_CNAME=cname.vercel-dns.com
