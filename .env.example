# ============================================================
# sahibindenhayvan.com — Ortam Değişkenleri
# Bu dosyayı kopyalayın: cp .env.example .env
# Vercel'de her birini Environment Variables olarak ekleyin.
# ============================================================

# ── Veritabanı (Supabase PostgreSQL) ─────────────────────────
# Supabase Dashboard → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[SIFRE]@db.[PROJE_ID].supabase.co:5432/postgres

# Ayrı ayrı bağlantı bilgileri (Drizzle / connect-pg-simple için)
PGHOST=db.[PROJE_ID].supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=[SIFRE]

# ── Supabase Storage (dosya / resim depolama) ────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://[PROJE_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role (gizli, sadece sunucu tarafı)
SUPABASE_ANON_KEY=eyJ...          # anon / public key
SUPABASE_STORAGE_BUCKET=uploads   # Supabase Storage'da oluşturduğunuz bucket adı

# ── Oturum ───────────────────────────────────────────────────
# Rastgele güçlü bir string: openssl rand -base64 32
SESSION_SECRET=guclu-bir-session-secret-buraya

# ── Redis (Upstash — opsiyonel, caching için) ─────────────────
# https://console.upstash.com → Yeni veritabanı → REST API
UPSTASH_REDIS_REST_URL=https://[AD]-[BOLGE].upstash.io
UPSTASH_REDIS_REST_TOKEN=eyJ...
UPSTASH_REDIS_PASSWORD=[SIFRE]

# ── E-posta (Resend) ─────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...

# ── Firebase (Bildirimler / FCM) ─────────────────────────────
# Firebase Console → Proje Ayarları → Hizmet Hesapları → Yeni anahtar
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@proje.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── reCAPTCHA (Spam koruması) ────────────────────────────────
# https://www.google.com/recaptcha/admin → Site oluştur
RECAPTCHA_SECRET_KEY=6Le...

# ── Replit Auth (SADECE Replit'te gerekli, Vercel'de opsiyonel) ─
# REPL_ID=             # Replit tarafından otomatik set edilir
# ISSUER_URL=          # https://replit.com/oidc (Replit default)

# ── Uygulama Ortamı ──────────────────────────────────────────
NODE_ENV=production

# ── Vercel için özel ─────────────────────────────────────────
# Vercel bu değişkeni otomatik ekler — elle eklemenize gerek yok:
# VERCEL=1
